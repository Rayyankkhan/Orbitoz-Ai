{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@orbitoz/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
