# ===========================================================================
# Orbitoz AI — environment template
# Copy to `.env` at the repo root:  cp .env.example .env
# ===========================================================================

# --- Shared ----------------------------------------------------------------
NODE_ENV=development

# --- Postgres --------------------------------------------------------------
# Matches the `postgres` service in docker-compose.yml
#
# TWO ROLES, ON PURPOSE. Row Level Security is not enforced for a table's owner
# and is always bypassed by a superuser, and docker-compose's `orbitoz` user is
# both. Connecting as `orbitoz` therefore switches off every policy in
# packages/database/prisma/rls.sql — so the runtime gets its own role, and
# `pnpm db:verify:tenancy` runs against it to prove enforcement for real.
#
#   DIRECT_DATABASE_URL -> `orbitoz`      migrations, seeds, role/RLS admin
#   APP_DATABASE_URL    -> `orbitoz_app`  the runtime application
#
# The app password is a development placeholder created by
# packages/database/prisma/roles.sql. Production provisions the role from the
# platform secret store instead.
DATABASE_URL="postgresql://orbitoz_app:orbitoz_app_dev_password@localhost:5432/orbitoz_db?schema=public&connection_limit=10&pool_timeout=20"
APP_DATABASE_URL="postgresql://orbitoz_app:orbitoz_app_dev_password@localhost:5432/orbitoz_db?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://orbitoz:orbitoz_dev_password@localhost:5432/orbitoz_db?schema=public"
# Prisma Migrate needs to create/drop a scratch database for drift detection.
SHADOW_DATABASE_URL="postgresql://orbitoz:orbitoz_dev_password@localhost:5432/orbitoz_db_shadow?schema=public"

# --- Redis -----------------------------------------------------------------
# Matches the `redis` service in docker-compose.yml.
# The gateway is the producer: it enqueues a job when an approval is granted.
REDIS_URL="redis://localhost:6379"
REDIS_TLS=false
# Upper bound on a single Redis command, in ms. The gateway holds this connection
# inside an HTTP request, so an enqueue that hangs forever holds the request, its
# transaction and a pooled Postgres connection open on a half-open socket. An error
# lets the handler answer, and the approval decision stays durable for a retry.
REDIS_COMMAND_TIMEOUT_MS=10000

# Disposable Redis for `pnpm test:integration`. Deliberately separate from
# REDIS_URL: the integration suite deletes keys, so it must never be pointed at a
# shared or staging instance. Start it with `docker compose up -d redis`.
# TEST_REDIS_URL="redis://localhost:6379"

# --- API Gateway (apps/api-gateway) ----------------------------------------
API_GATEWAY_PORT=4000
API_GATEWAY_GLOBAL_PREFIX=v1
API_GATEWAY_CORS_ORIGINS="http://localhost:3000"
API_GATEWAY_SWAGGER_ENABLED=true

# --- Auth ------------------------------------------------------------------
# MUST be replaced in every non-local environment (>= 32 chars each).
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_ISSUER=orbitoz.ai
JWT_AUDIENCE=orbitoz.ai:api

# --- Multi-tenancy ---------------------------------------------------------
# Tenants are resolved from the request host subdomain: acme.orbitoz.ai
TENANT_ROOT_DOMAIN=orbitoz.ai
TENANT_HEADER=x-orbitoz-tenant
# Allow a single-tenant deployment to disable subdomain resolution entirely.
TENANT_REQUIRED=true

# --- Human-in-the-loop approvals --------------------------------------------
# HMAC key for approval decision grants. MUST be replaced in every non-local
# environment (>= 32 chars), and MUST differ from both JWT secrets: an approval
# signature is verified by a public route no session can reach, so sharing a key
# would let a grant minted for an approval link be presented as a bearer token.
APPROVAL_SIGNING_SECRET="dev-only-approval-secret-change-me-0123456789abcdef"
# Accepted clock difference on a decision grant, in seconds. Generous enough to
# click a link on a phone, short enough that a signature in browser history is
# dead by the next day.
APPROVAL_SIGNATURE_TOLERANCE_SECONDS=300
# How long an approval link stays decidable, in seconds. A day is long enough for
# a person to notice and act, short enough that an approval queue does not
# accumulate month-old "run this now" jobs nobody meant to authorise.
APPROVAL_TTL_SECONDS=86400

# --- Worker service (apps/worker-service) ----------------------------------
WORKER_SERVICE_PORT=4010
# Jobs run in parallel per tenant queue.
WORKER_CONCURRENCY=10
# Tenants this process subscribes to, PER queue-type. This is really a connection
# budget: BullMQ opens two sockets per subscribed tenant (one blocking, one for
# commands), so 4 queue-types x 50 tenants = 400 connections. Past the cap the
# worker refuses new tenants instead of letting Redis refuse them — scale out with
# more replicas rather than raising this.
WORKER_MAX_TENANTS=50
# Aggregate job rate across all of this worker's tenants, and its window.
WORKER_RATE_LIMIT_MAX=50
WORKER_RATE_LIMIT_DURATION_MS=1000
# How often the worker re-reads the `tenants` table. A poll rather than a pub/sub:
# the database is the authority on which tenants exist, so a worker that starts
# after a tenant was created has no notification to receive.
WORKER_TENANT_REFRESH_INTERVAL_MS=30000
# Command timeout for the worker's producer-side Redis connection, in ms. Not
# applied to BullMQ's blocking clients, which must be free to wait. There is
# deliberately no maxConnections knob: ioredis 6 removed the per-client connection
# pool, so it would be accepted and ignored.
WORKER_REDIS_COMMAND_TIMEOUT_MS=10000
# How long a dead-lettered job is retained before an operator must act. Routing
# itself is decided in code, not config, so this cannot stop dead-lettering.
DLQ_RETENTION_DAYS=30
QUEUE_AI_INFERENCE=ai-inference
QUEUE_NAME_PREFIX=orbitoz

# --- Web (apps/web) --------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:4000/v1"
NEXT_PUBLIC_APP_NAME="Orbitoz AI"
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=orbitoz.ai

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
