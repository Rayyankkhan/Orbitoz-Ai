# pnpm 10 configuration for the Orbitoz AI monorepo.
# Reference: https://pnpm.io/settings

# Strict, isolated node_modules (the default in pnpm 10). No shamefully-hoist.
node-linker=isolated
shamefully-hoist=false

# Peer dependency strategy: resolve peers automatically, but never explode on a
# single strict-peer warning during bootstrap.
auto-install-peers=true
dedupe-peer-dependents=true
strict-peer-dependencies=false
resolution-mode=highest

# Workspace packages always link locally, and `pnpm add` prefers the local copy.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Warn when a package.json script relies on a binary from an undeclared dependency.
verify-deps-before-run=warn

# Deterministic installs in CI.
prefer-frozen-lockfile=true
