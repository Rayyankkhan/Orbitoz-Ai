{
  "extends": "@orbitoz/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "prisma.config.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
